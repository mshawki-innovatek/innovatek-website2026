{
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/_next/static/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=86400, must-revalidate" }
    }
  ],
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
