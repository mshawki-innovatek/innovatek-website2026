# Canonical public origin used by metadata, hreflang, JSON-LD, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.innovatek-swd.com

# Contact + demo form delivery (EmailJS). All three are required for the form to
# send; if any is missing the form skips the send and offers the direct-email
# fallback instead. Values are read at build time and are visible in the browser
# by design - the public key is meant to be public.
#
# Get them from https://dashboard.emailjs.com :
#   Email Services -> your service   -> Service ID
#   Email Templates -> your template -> Template ID
#   Account -> General               -> Public Key
#
# The template must use these exact variable names (case-sensitive):
#   {{from_name}} {{Email}} {{Company}} {{Phone}} {{services}} {{message}}
# and its "To Email" must be the address that should receive enquiries.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional public ownership verification codes from Search Console / Bing.
# Leave blank until the website owner supplies them. No analytics are injected.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
